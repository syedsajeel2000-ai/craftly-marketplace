# -------------------------------------------------------------
# Craftly Marketplace — environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to GitHub.
# -------------------------------------------------------------

# Turso database (libSQL). REQUIRED in production — serverless platforms have a
# read-only, ephemeral filesystem, so the local SQLite file cannot be used once
# deployed. Create one at turso.tech (`turso db create craftly`), then read the
# values with `turso db show <db-name>`.
# Local development alternative: TURSO_DATABASE_URL=file:./data/craftly.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server
PORT=8787

# Secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Bearer token guarding /api/cron/daily, which publishes the day's new listings.
# Set this so only your scheduler (Vercel Cron) can trigger it.
CRON_SECRET=
